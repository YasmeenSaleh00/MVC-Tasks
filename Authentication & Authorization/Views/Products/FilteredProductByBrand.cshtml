@model IEnumerable<Practise_Database_Migration.Models.Product>

@{
    ViewData["Title"] = "Products";
}

@section Styles {
    <style>
        body {
            background-color: #FFF5F8;
        }

        .card-hover {
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            border: none;
            box-shadow: 0 15px 30px rgba(214, 51, 108, 0.15) !important;
        }

            .card-hover:hover {
                transform: translateY(-10px);
            }

        .btn-add-cart {
            background-color: #FFD1E8;
            color: #495057;
            border-radius: 10px;
            font-weight: 600;
            border: none;
            transition: 0.3s;
        }

            .btn-add-cart:hover {
                background-color: #f7a8cc !important;
            }

        .category-header {
            background: linear-gradient(45deg, #FF4081, #FF80AB);
            color: white;
            padding: 20px;
            border-radius: 20px 20px 0 0;
        }

        .info-label {
            color: #FF4081;
            font-weight: bold;
            font-size: 0.8rem;
            text-transform: uppercase;
            margin-top: 10px;
        }

        .info-value {
            padding-bottom: 5px;
            border-bottom: 1px solid #eee;
            margin-bottom: 10px;
        }

        .img-preview-container img {
            max-width: 100%;
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }
    </style>
}

<div class="container mt-5">
    <div class="row">
        @foreach (var prod in Model)
        {
            <div class="col-lg-3 col-md-4 col-sm-6 mb-5">
                <div class="card card-hover shadow-sm h-100" style="border-radius: 20px;">
                    <div class="image-container p-3" style="background-color: #f8f9fa; border-radius: 20px 20px 0 0;">
                        <img src="~/images/Products/@prod.ImagePath" class="card-img-top" style="height: 200px; object-fit: contain;">
                    </div>
                    <div class="card-body d-flex flex-column p-3">
                        <h6 class="card-title fw-bold">@prod.Name</h6>
                        <div class="price-tag mb-3">
                            <span class="fw-bold" style="color: #D6336C;">@prod.Price JD</span>
                        </div>
                        <div class="d-grid gap-2 mt-auto">
                            <button class="btn btn-add-cart">Add To Cart</button>

                            <button type="button" class="btn btn-outline-pink"
                                    style="border-radius: 10px; border: 1px solid #FF4081; color: #FF4081;"
                                    data-bs-toggle="modal" data-bs-target="#modal-@prod.Id">
                                View Details
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal fade" id="modal-@prod.Id" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                    <div class="modal-content" style="border-radius: 20px; border: none;">

                        <div class="category-header d-flex justify-content-between align-items-center">
                            <div>
                                <h4 class="mb-0">Product Overview</h4>
                                <p class="mb-0 opacity-75" style="font-size: 0.8rem;">Detailed info about @prod.Name</p>
                            </div>
                            <div class="price-tag" style="font-size: 1.5rem; font-weight: 800;">
                                @prod.Price JD
                            </div>
                        </div>

                        <div class="modal-body p-4">
                            <div class="row">
                                <div class="col-md-5 mb-3">
                                    <div class="img-preview-container text-center">
                                        <img src="~/images/Products/@prod.ImagePath" alt="@prod.Name" />
                                    </div>
                                </div>
                                <div class="col-md-7">
                                    <div class="info-label">Category Name</div>
                                    <div class="info-value">@prod.Category?.Name</div>

                                    <div class="info-label">Brand Name</div>
                                    <div class="info-value">@prod.Brand?.Name</div>

                                    <div class="info-label">Description</div>
                                    <div class="info-value" style="font-size: 0.9rem;">@prod.Description</div>

                                    <div class="row">
                                        <div class="col-6">
                                            <div class="info-label">Stock Status</div>
                                            <div class="info-value">
                                                @if (prod.StockQuantity > 0)
                                                {
                                                    <span class="text-success small">In Stock (@prod.StockQuantity)</span>
                                                }
                                                else
                                                {
                                                    <span class="text-danger small">Out of Stock</span>
                                                }
                                            </div>
                                        </div>
                                      
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer border-0">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" style="border-radius: 10px;">Close</button>
                            <button class="btn btn-add-cart">Add To Cart</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
