@{
    ViewData["Title"] = "Home Page";
}
@model Tuple<List<Category>, List<Brand>,List<Product>>
@section Icons {
    <link rel="icon" type="image/x-icon" href="~/images/Logo/logo.png">
}
@section Styles {
    <style>
    
        .head {
            color: #D6336C;
            text-shadow: 0 0 5px #fff, 0 0 10px #fff, 0 0 15px #ff4081, 0 0 20px #ff4081;
        }
        p{
            color: #495057;
        }
        .link{
            color: #D6336C;
            text-shadow: 0 0 5px #fff, 0 0 10px #fff, 0 0 15px #ff4081, 0 0 20px #ff4081;
            text-decoration:none;
        }
        .link:hover{
                color: #495057;
        }
        html, body {
            height: 100%;
        }

        body {
            display: flex;
            flex-direction: column;
            background-color: #FFF5F8; 
        }

        .privacy-link {
            color: #D6336C;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
        }

            .privacy-link:hover {
                color: #ff4081;
                text-shadow: 0px 0px 8px rgba(255, 64, 129, 0.2);
                text-decoration: underline;
            }

    
        .btn-primary {
            background: linear-gradient(45deg, #D6336C, #FF4081) !important;
            border: none;
            border-radius: 10px;
            padding: 12px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

            .btn-primary:hover {
                background: linear-gradient(45deg, #FF4081, #D6336C) !important;
                transform: translateY(-3px) !important;
                box-shadow: 0 5px 15px rgba(214, 51, 108, 0.3) !important;
            }

        .back-link {
            color: #D6336C !important;
            text-decoration: none;
            font-weight: 500;
        }

            .back-link:hover {
                color: #FF4081 !important;
            }

        .category-slider {
            display: flex;
            overflow-x: auto;
            gap: 30px;
            padding: 20px 10px;
            scrollbar-width: none;
        }

            .category-slider::-webkit-scrollbar {
                display: none;
            }

        .cat-item {
            flex: 0 0 auto;
            text-align: center;
            transition: all 0.4s ease;
            cursor: pointer;
            width: 150px;
        }

        .cat-img-wrapper {
            width: 120px;
            height: 120px;
            border-radius: 50%; 
            padding: 5px;
            background: #fff;
            box-shadow: 0 5px 15px rgba(214, 51, 108, 0.15);
            margin: 0 auto 15px;
            transition: all 0.4s ease;
            border: 2px solid transparent;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .cat-item:hover .cat-img-wrapper {
            transform: scale(1.1);
            box-shadow: 0 10px 25px rgba(214, 51, 108, 0.3); 
            border-color: #D6336C;
        }

        .cat-img-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 50%;
        }

        .cat-name {
            font-weight: 600;
            color: #495057;
            transition: color 0.3s ease;
        }

        .cat-item:hover .cat-name {
            color: #D6336C;
        }
    </style>
}
<div id="heroCarousel" class="carousel slide" data-bs-ride="carousel">
    <div class="carousel-inner">
        <div class="carousel-item active">
            <img src="~/images/sliderone.jpg"
                 class="d-block w-100 "
                 alt="Makeup Beauty"
                 height="400px" />
            <div class="carousel-caption d-none d-md-block">
                <h2>Discover Your Beauty</h2>
                <p class="text-black">
                    Enchanting makeup collections and special offers for you!
                </p>
                <a routerLink="/product-card" class="btn btn-pink">Shop Now !</a>
            </div>
        </div>
        <div class="carousel-item">
            <img src="~/images/slider2.jpg"
                 class="d-block w-100"
                 alt="Lipsticks"
                 height="400px" />
            <div class="carousel-caption d-none d-md-block">
                <h2 class="text-pink">Best for Your skin</h2>

                <a routerLink="/product-card" class="btn btn-pink">Discover now !</a>
            </div>
        </div>
    </div>

    <button class="carousel-control-prev"
            type="button"
            data-bs-target="#heroCarousel"
            data-bs-slide="prev">
        <span class="carousel-control-prev-icon"></span>
    </button>
    <button class="carousel-control-next"
            type="button"
            data-bs-target="#heroCarousel"
            data-bs-slide="next">
        <span class="carousel-control-next-icon"></span>
    </button>
</div>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="head fw-bold">Shop By Category</h3>
        <a asp-controller="Categories" asp-action="Index" class="privacy-link">View All →</a>
    </div>

    <div class="category-slider">
        @foreach (var cat in Model.Item1.Slice(0,6))
        {
            <a asp-controller="Products" asp-action="FilteredProductByCategory" asp-route-categoryId="@cat.Id" class="cat-item text-decoration-none">
                <div class="cat-img-wrapper">
                    <img src="~/images/Categories/@cat.ImagePath" alt="@cat.Name">
                </div>
                <span class="cat-name d-block">@cat.Name</span>
            </a>
        }
    </div>
</div>
<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="head fw-bold">Shop By Brand</h3>
        <a asp-controller="Brands" asp-action="Index" class="privacy-link">View All →</a>
    </div>

    <div class="category-slider">
        @foreach (var cat in Model.Item2)
        {
            <a asp-controller="Products" asp-action="FilteredProductByBrand" asp-route-brandId="@cat.Id" class="cat-item text-decoration-none">
                <div class="cat-img-wrapper">
                    <img src="~/images/Brands/@cat.ImagePath" alt="@cat.Name">
                </div>
                <span class="cat-name d-block">@cat.Name</span>
            </a>
        }
    </div>
</div>
